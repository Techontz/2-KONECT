APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Firebase Authentication — customer Google sign-in.
# Only the project id is needed: ID tokens are verified against Google's public
# certificates, so no service-account private key is stored on the server.
FIREBASE_PROJECT_ID=konect-83a21
# Comma-separated. Older projects still minting tokens from shipped clients.
# Remove the legacy Firebase project ID after the updated Flutter application
# using konect-83a21 has been released and existing users have migrated.
FIREBASE_LEGACY_PROJECT_IDS=direct2kariakoo-56782

# AzamPay (legacy mobile-money checkout). Off by default: nothing in this
# repository calls it, and while it is off the routes are not registered at all.
#
# AZAMPAY_CALLBACK_SECRET is a gate we own, not a provider signature — AzamPay
# publishes no callback signing mechanism. It stops the callback endpoint being
# a public write; it is not, and must never be treated as, grounds to settle a
# payment. Generate with: php -r "echo bin2hex(random_bytes(32));"
AZAMPAY_ENABLED=false
AZAMPAY_CALLBACK_SECRET=
# Optional. Comma-separated IPs or CIDR ranges, once AzamPay confirms theirs.
AZAMPAY_CALLBACK_IPS=

# Stripe (hosted Checkout). TEST MODE ONLY in this release.
#
# Two independent switches: STRIPE_ENABLED decides whether the routes exist,
# and the `stripe` row in checkout_payment_channels decides whether a shopper
# is offered it. Both ship off. Neither flips by deploying code.
#
# Prefer a RESTRICTED key (rk_test_...) over a secret key (sk_test_...): this
# integration needs only Checkout Sessions write, PaymentIntents read and
# Events read. STRIPE_ALLOW_LIVE must stay false — a live key is refused
# without it, so a copied env file cannot start taking real money.
#
# STRIPE_WEBHOOK_SECRET is a separate credential and differs between test and
# live. Local: stripe listen --forward-to localhost:8001/api/webhooks/stripe
STRIPE_ENABLED=false
STRIPE_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_LIVE=false
# TZS is a supported presentment currency and is NOT zero-decimal to Stripe —
# amounts are submitted x100. See App\Support\Money::toMinorUnits().
STRIPE_CURRENCY=TZS

# Refuse an order smaller than this, in minor units (TZS 1,300 = 130000).
# Leave at 0 unless a real declined attempt has told you the true floor:
# Stripe enforces its minimum against the currency it settles in, not TZS,
# so a guess set too high refuses orders Stripe would have taken.
STRIPE_MINIMUM_MINOR=0
STRIPE_RETURN_BASE_URL=https://www.2konect.shop
