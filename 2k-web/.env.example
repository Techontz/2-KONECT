# 2KONECT storefront — example configuration. Copy to .env.local.
# Every value here is a public client identifier. Firebase web config is
# designed to ship in a browser bundle; it identifies the project and does not
# authorise anything. Never put a service-account key in this file.

# The name the code actually reads is NEXT_PUBLIC_API_URL (lib/api.ts).
NEXT_PUBLIC_API_URL=https://api.2konect.com/api

# Absolute origin for metadata, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://2konect.com

# Where product/vendor/banner media is served from.
NEXT_PUBLIC_STORAGE_URL=

# Read by lib/firebase.ts. MEASUREMENT_ID is not read by any code today —
# only add it if Analytics is wired up later.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=direct2kariakoo-56782.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=direct2kariakoo-56782
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=direct2kariakoo-56782.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional. Each is read by exactly one place and the feature that needs it
# simply does not render when it is absent — no broken control, no error.
#   MAPS  -> the delivery-address picker (components/location/LocationPicker)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
