# =============================================================================
# 2KONECT — repository hygiene
#
# The rule: source code and the files genuinely needed to build or run the
# project. Not build output, not dependencies, not secrets, not media, and not
# old copies of the project.
# =============================================================================

# ----------------------------------------------------------------- secrets --
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
*.mobileprovision
auth.json
google-services.json
GoogleService-Info.plist
firebase-service-account*.json
credentials.json
service-account*.json
**/android/local.properties
**/android/gradle.properties
**/android/key.properties
*.creds.json
admin.creds.json

# ------------------------------------------------------------ dependencies --
node_modules/
# Composer's directory, named explicitly.
#
# A bare `vendor/` matches any directory with that name at any depth, and four
# of ours hold source: the Next.js /vendor route and its components (the whole
# seller dashboard), the Flutter seller screens, and Laravel's published vendor
# views. None of them had ever been committed, which is why every /vendor/*
# page on the live site answered 404.
/d2k_backend/vendor/
**/Pods/
.pub-cache/

# ---------------------------------------------------------------- build out --
build/
dist/
out/
.next/
.nuxt/
.turbo/
.parcel-cache/
*.apk
*.aab
*.ipa
*.app
*.dSYM/

# -------------------------------------------------------------- Flutter/Dart --
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
**/generated_plugin_registrant.dart

# ------------------------------------------------------------------ Android --
.gradle/
**/android/.gradle/
**/android/captures/
*.iml

# ---------------------------------------------------------------------- iOS --
**/ios/Flutter/Flutter.framework
**/ios/Flutter/App.framework
**/ios/Flutter/ephemeral/
**/ios/.symlinks/
DerivedData/
*.xcuserstate
**/xcuserdata/

# ------------------------------------------------------------------ Laravel --
/d2k_backend/storage/*.key
/d2k_backend/storage/framework/cache/data/*
/d2k_backend/storage/framework/sessions/*
/d2k_backend/storage/framework/views/*
/d2k_backend/storage/framework/testing/*
/d2k_backend/storage/logs/*
/d2k_backend/storage/app/public/*
/d2k_backend/public/storage
/d2k_backend/public/hot
/d2k_backend/bootstrap/cache/*.php
!.gitkeep

# --------------------------------------------------------- database & dumps --
*.sql
*.sqlite
*.sqlite3
*.dump
_backups/
_quarantine/

# ------------------------------------------------------------------- media --
# Product/vendor/banner media lives in the database-backed storage disk and on
# the server, not in source control.
/public_html/
**/storage/app/public/
**/public/uploads/

# -------------------------------------------------------- old project copies --
DOCS/
# The previous deployment copy, if it is ever restored alongside the project.
DIRECT2KARIAKOO BACKEND/
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# ----------------------------------------------------- recordings & captures --
*.mov
*.mp4
*.avi
*.webm
ScreenRecording*
Screen?Recording*

# -------------------------------------------------------------------- logs --
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --------------------------------------------------------------------- IDE --
.idea/
.vscode/
*.swp
*.swo
*~

# --------------------------------------------------------------------- OS --
.DS_Store
Thumbs.db
desktop.ini

# Throwaway Chrome profiles left by browser-driven testing.
cdp*/
chrome-profile*/

# ------------------------------------------------------------------ caches --
.phpunit.result.cache
.eslintcache
coverage/
.nyc_output/

# Local database and env backups taken before the 2KONECT transformation.
.backups/
*.pre-2konect.bak
